# Copy this file to .env and fill in your real values. Never commit .env to GitHub.

# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers -> Node.js
# Looks like: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/docuchat
MONGODB_URI=mongodb+srv://greta17890_db_user:<db_password>@docmind.dxpvegu.mongodb.net/?appName=DocMind

# Gemini API key (free tier)
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

PORT=5000
